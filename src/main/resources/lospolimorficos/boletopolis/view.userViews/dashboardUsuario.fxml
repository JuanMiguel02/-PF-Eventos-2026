<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0"
            prefWidth="1280.0"
            stylesheets="@../styles/dashboardUsuario.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lospolimorficos.boletopolis.viewController.viewControllersAdmin.Usuario.DashboardUsuarioController">



    <left>

        <VBox prefWidth="240.0"
              styleClass="sidebar">

            <padding>
                <Insets top="25"
                        right="15"
                        bottom="25"
                        left="15"/>
            </padding>

            <Label text="BOLETÓPOLIS"
                   styleClass="logo-text"/>

            <Region VBox.vgrow="NEVER"/>

            <Button text="Inicio"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    onAction="#mostrarInicio"/>

            <Button text="Eventos"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    onAction="#mostrarEventos"/>

            <Button text="Mis Compras"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    onAction="#mostrarCompras"/>

            <Button text="Métodos de Pago"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    onAction="#mostrarMetodosPago"/>

            <Button text="Perfil"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    onAction="#mostrarPerfil"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Cerrar Sesión"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    onAction="#cerrarSesion"/>

        </VBox>

    </left>



    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="header">

            <padding>
                <Insets top="15"
                        right="25"
                        bottom="15"
                        left="25"/>
            </padding>

            <Label text="LOS POLIMÓRFICOS"
                   styleClass="header-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblNombreUsuario"
                   text="Hola Usuario"
                   style="-fx-font-size: 15px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #163A36;"/>

        </HBox>

    </top>



    <center>

        <StackPane fx:id="contentPane"
                   styleClass="content-panel"/>

    </center>

</BorderPane>