<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="lospolimorficos.boletopolis.viewController.viewControllersUsuario.PerfilUsuarioController"
      prefHeight="600.0" prefWidth="850.0" style="-fx-padding: 30;">

    <Label text="Mi Perfil" style="-fx-font-size: 24; -fx-font-weight: bold;"/>

    <HBox spacing="40" VBox.vgrow="ALWAYS">
        <VBox spacing="15" prefWidth="380">
            <Label text="Información Personal" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10">
                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Apellido:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtApellido" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Documento:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtDocumento" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtCorreo" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Contraseña Actual:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <PasswordField fx:id="txtPasswordActual" promptText="Requerido para cambios" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="Nueva Contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <PasswordField fx:id="txtPasswordNueva" promptText="Opcional" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                <Label text="Confirmar Nueva:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                <PasswordField fx:id="txtPasswordConfirmar" promptText="Repita la nueva" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
            </GridPane>

            <Button text="Guardar Cambios" onAction="#guardarCambios" maxWidth="Infinity"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>

        <Separator orientation="VERTICAL"/>

        <VBox spacing="15" HBox.hgrow="ALWAYS">
            <Label text="Notificaciones" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <ListView fx:id="listNotificaciones" VBox.vgrow="ALWAYS"/>
            <Button text="Limpiar Notificaciones" onAction="#limpiarNotificaciones"
                    style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
        </VBox>
    </HBox>

</VBox>