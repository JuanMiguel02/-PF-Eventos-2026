<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller=""
      prefHeight="700.0"
      prefWidth="1200.0"
      style="-fx-padding: 25; -fx-background-color: #F5F7FA;">

    <!-- TÍTULO -->
    <Label text="Historial de Compras"
           style="-fx-font-size: 28px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #163A36;"/>

    <!-- FILTROS -->
    <VBox spacing="15"
          style="-fx-background-color: white;
                 -fx-padding: 20;
                 -fx-background-radius: 15;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10,0,0,2);">

        <children>

            <Label text="Filtros"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #163A36;"/>

            <HBox spacing="15">

                <!-- FECHA INICIO -->
                <VBox spacing="5">
                    <Label text="Fecha Inicio"/>
                    <DatePicker fx:id="dpFechaInicio"
                                prefWidth="180"/>
                </VBox>

                <!-- FECHA FIN -->
                <VBox spacing="5">
                    <Label text="Fecha Fin"/>
                    <DatePicker fx:id="dpFechaFin"
                                prefWidth="180"/>
                </VBox>

                <!-- EVENTO -->
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Evento"/>
                    <ComboBox fx:id="cbEventos"
                              promptText="Todos los eventos"
                              maxWidth="Infinity"/>
                </VBox>

                <!-- ESTADO -->
                <VBox spacing="5">
                    <Label text="Estado"/>
                    <ComboBox fx:id="cbEstado"
                              prefWidth="180"
                              promptText="Todos"/>
                </VBox>

            </HBox>

            <!-- BOTONES -->
            <HBox spacing="10">

                <Button text="Aplicar Filtros"
                        onAction="#filtrarCompras"
                        style="-fx-background-color: #2E7D5A;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;
                               -fx-padding: 10 20 10 20;"/>

                <Button text="Limpiar"
                        onAction="#limpiarFiltros"
                        style="-fx-background-color: white;
                               -fx-border-color: #163A36;
                               -fx-border-radius: 10;
                               -fx-background-radius: 10;
                               -fx-font-weight: bold;
                               -fx-padding: 10 20 10 20;"/>

            </HBox>

        </children>

    </VBox>

    <!-- TABLA -->
    <VBox VBox.vgrow="ALWAYS"
          spacing="10"
          style="-fx-background-color: white;
                 -fx-padding: 20;
                 -fx-background-radius: 15;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10,0,0,2);">

        <children>

            <Label text="Compras Realizadas"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #163A36;"/>

            <TableView fx:id="tablaCompras"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colFecha"
                                 text="Fecha"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colEvento"
                                 text="Evento"
                                 prefWidth="250"/>

                    <TableColumn fx:id="colCantidad"
                                 text="Entradas"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colTotal"
                                 text="Total"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colMetodoPago"
                                 text="Método Pago"
                                 prefWidth="180"/>

                    <TableColumn fx:id="colEstado"
                                 text="Estado"
                                 prefWidth="150"/>

                </columns>

            </TableView>

        </children>

    </VBox>

    <!-- REPORTES -->
    <HBox spacing="15"
          alignment="CENTER_RIGHT">

        <Button text="Descargar CSV"
                onAction="#descargarCSV"
                style="-fx-background-color: #245C52;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 10;
                       -fx-padding: 12 25 12 25;"/>

        <Button text="Descargar PDF"
                onAction="#descargarPDF"
                style="-fx-background-color: #163A36;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 10;
                       -fx-padding: 12 25 12 25;"/>

    </HBox>

</VBox>