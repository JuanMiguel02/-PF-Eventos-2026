<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0"
            prefWidth="1200.0"
            stylesheets="@../styles/login.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lospolimorficos.boletopolis.viewController.viewControllersUsuario.LoginController">

    <top>
        <HBox alignment="CENTER_RIGHT" prefHeight="40.0" spacing="0">
            <Button onAction="#minimizar"
                    styleClass="minimize-button"
                    text="—"
                    prefHeight="40.0"
                    prefWidth="45.0"/>

            <Button onAction="#cerrar"
                    styleClass="close-button"
                    text="✕"
                    prefHeight="40.0"
                    prefWidth="45.0"/>
        </HBox>
    </top>

    <left>
        <VBox alignment="CENTER"
              spacing="20"
              prefWidth="450"
              styleClass="left-panel">

            <Label text="BOLETOPOLIS"
                   styleClass="titulo-logo"/>

            <Label text="Sistema de Gestión de Eventos"
                   styleClass="subtitulo-logo"/>

            <Label text="Compra entradas, explora eventos y vive experiencias únicas."
                   wrapText="true"
                   maxWidth="300"
                   styleClass="descripcion-logo"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER"
              spacing="20"
              styleClass="right-panel">

            <VBox spacing="15"
                  maxWidth="380"
                  styleClass="login-card">
                <Label text="Iniciar Sesión"
                       styleClass="titulo-login"/>

                <TextField fx:id="txtCorreo"
                           promptText="Correo electrónico"
                           styleClass="input"/>

                <HBox spacing="10" alignment="CENTER_LEFT">

                    <StackPane HBox.hgrow="ALWAYS">

                        <PasswordField fx:id="txtPassword"
                                       promptText="Contraseña"
                                       styleClass="input"/>

                        <TextField fx:id="txtPasswordVisible"
                                   promptText="Contraseña"
                                   styleClass="input"
                                   visible="false"
                                   managed="false"/>

                    </StackPane>

                    <Button text="👁"
                            onAction="#mostrarPassword"
                            styleClass="btn-eye"/>

                </HBox>

                <Button text="Ingresar"
                        onAction="#iniciarSesion"
                        styleClass="btn-login"/>

                <Button text="Registrarse"
                        onAction="#handleRegistrar"
                        styleClass="btn-register"/>

            </VBox>

        </VBox>
    </center>

</BorderPane>