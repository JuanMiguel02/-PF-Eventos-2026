<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0"
            prefWidth="1200.0"
            stylesheets="@../styles/login.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lospolimorficos.boletopolis.viewController.viewControllersUsuario.RegistroClienteController">

    <!-- PANEL IZQUIERDO -->
    <left>
        <VBox alignment="CENTER"
              prefWidth="450.0"
              spacing="20.0"
              styleClass="left-panel">

            <children>

                <Label styleClass="titulo-logo"
                       text="BOLETÓPOLIS"/>

                <Label styleClass="subtitulo-logo"
                       text="Registro de Clientes"/>

                <Label styleClass="descripcion-logo"
                       text="Crea tu cuenta y comienza a comprar entradas para tus eventos favoritos."
                       wrapText="true"
                       maxWidth="300"/>

            </children>

        </VBox>
    </left>

    <!-- PANEL DERECHO -->
    <center>

        <VBox alignment="CENTER"
              styleClass="right-panel">

            <children>

                <VBox alignment="CENTER"
                      spacing="18.0"
                      styleClass="login-card"
                      maxWidth="420">

                    <padding>
                        <Insets top="40"
                                right="40"
                                bottom="40"
                                left="40"/>
                    </padding>

                    <children>

                        <Label styleClass="titulo-login"
                               text="Crear Cuenta"/>

                        <TextField fx:id="txtNombre"
                                   promptText="Nombre"
                                   styleClass="input"/>

                        <TextField fx:id="txtApellido"
                                   promptText="Apellido"
                                   styleClass="input"/>

                        <TextField fx:id="txtDocumento"
                                   promptText="Documento"
                                   styleClass="input"/>

                        <TextField fx:id="txtEmail"
                                   promptText="Correo Electrónico"
                                   styleClass="input"/>

                        <TextField fx:id="txtTelefono"
                                   promptText="Número de Teléfono"
                                   styleClass="input"/>

                        <PasswordField fx:id="txtContrasena"
                                       promptText="Contraseña"
                                       styleClass="input"/>

                        <Button text="Registrarse"
                                prefWidth="300"
                                styleClass="btn-login"
                                onAction="#handleRegistrar"/>

                        <Button text="Volver al Login"
                                prefWidth="300"
                                styleClass="btn-register"
                                onAction="#handleVolverLogin"/>

                    </children>

                </VBox>

            </children>

        </VBox>

    </center>

</BorderPane>