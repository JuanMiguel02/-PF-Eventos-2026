<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15"
      prefWidth="1250.0"
      prefHeight="750.0"
      style="-fx-padding: 20; -fx-background-color: #F5F5F5;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lospolimorficos.boletopolis.viewController.viewControllersUsuario.CompraUsuarioController">

    <Label fx:id="lblEvento"
           text="Compra de Entradas"
           style="-fx-font-size: 26;
                  -fx-font-weight: bold;
                  -fx-text-fill: #163A36;" />

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <VBox spacing="12"
              VBox.vgrow="ALWAYS"
              HBox.hgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Seleccione sus asientos:"
                       style="-fx-font-size: 16;
                              -fx-font-weight: bold;" />

                <Region HBox.hgrow="ALWAYS" />

                <HBox spacing="6" alignment="CENTER_LEFT"
                      style="-fx-background-color: #EDECEC; -fx-padding: 6 12 6 12; -fx-background-radius: 20;">
                    <Region style="-fx-background-color: #D32F2F;
                                   -fx-pref-width: 12;
                                   -fx-pref-height: 12;
                                   -fx-background-radius: 50;" />
                    <Label text="Asientos de color rojo están ocupados"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #333333;" />
                </HBox>
            </HBox>

            <ScrollPane fx:id="scrollMapa"
                        fitToWidth="true"
                        fitToHeight="true"
                        pannable="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;
                               -fx-background: transparent;">

                <content>
                    <AnchorPane fx:id="panelMapa" minHeight="800.0" minWidth="1000.0" prefHeight="800.0" prefWidth="1000.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #ccc;" />
                </content>

            </ScrollPane>

        </VBox>

        <VBox spacing="15"
              prefWidth="360"
              minWidth="360"
              style="-fx-background-color: white;
                     -fx-padding: 20;
                     -fx-background-radius: 16;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10,0,0,2);">

            <Label text="Resumen de Selección"
                   style="-fx-font-size: 17;
                          -fx-font-weight: bold;
                          -fx-text-fill: #163A36;" />

            <Label fx:id="lblResumen"
                   text="Asientos seleccionados: 0 | Total: $0.00"
                   style="-fx-font-size: 14;" />

            <Separator />

            <Label text="Método de Pago:"
                   style="-fx-font-weight: bold;" />

            <ComboBox fx:id="cbMetodosPago"
                      maxWidth="Infinity" />

            <CheckBox fx:id="chkNotificaciones"
                      selected="true"
                      text="Recibir notificaciones del evento" />

            <Button text="Finalizar Compra"
                    maxWidth="Infinity"
                    onAction="#finalizarCompra"
                    style="-fx-background-color: #2E7D5A;
                           -fx-text-fill: white;
                           -fx-font-size: 14;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-padding: 12;" />

            <Separator />

            <Label text="Aforo por Zona"
                   style="-fx-font-size: 17;
                          -fx-font-weight: bold;
                          -fx-text-fill: #163A36;" />

            <TableView fx:id="tablaAforo"
                       VBox.vgrow="ALWAYS">

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>

                <columns>
                    <TableColumn fx:id="colZonaNombre" text="Zona" />
                    <TableColumn fx:id="colOcupacion" text="Ocupados" />
                    <TableColumn fx:id="colZonaCapacidad" text="Capacidad" />
                </columns>

            </TableView>

        </VBox>

    </HBox>

</VBox>