<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@../../styles/dashboardAdmin.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lospolimorficos.boletopolis.viewController.viewControllersAdmin.ComprasViewController">
    <children>
        <VBox layoutX="20.0" layoutY="20.0" prefHeight="560.0" prefWidth="760.0" spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="Administración de Compras" />
                
                <!-- Parte Superior: Filtros y Búsqueda -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 10;" styleClass="white-bg, shadow">
                    <children>
                        <TextField fx:id="txtBusqueda" prefWidth="300.0" promptText="Buscar por cliente o evento..." styleClass="search" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#limpiarFiltros" styleClass="clear-btn" text="Limpiar" />
                    </children>
                </HBox>

                <!-- Parte Central: La Tabla Maestra -->
                <TableView fx:id="tblCompras" styleClass="shadow" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="150.0" text="ID de Compra" />
                        <TableColumn fx:id="colCliente" prefWidth="200.0" text="Cliente" />
                        <TableColumn fx:id="colEvento" prefWidth="150.0" text="Evento" />
                        <TableColumn fx:id="colReembolsable" prefWidth="100.0" text="Reembolsable" />
                        <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
                        <TableColumn fx:id="colFecha" prefWidth="120.0" text="Fecha de Compra" />
                        <TableColumn fx:id="colTotal" prefWidth="100.0" text="Total ($)" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>

                <!-- Parte Inferior: Barra de Acciones -->
                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 10;" styleClass="white-bg, shadow">
                    <children>
                        <Button fx:id="btnReembolsar" disable="true" mnemonicParsing="false" onAction="#reembolsar" styleClass="delete-btn" text="Reembolsar" />
                        <Button fx:id="btnVerDetalles" disable="true" mnemonicParsing="false" onAction="#verDetalles" styleClass="update-btn" text="Ver Detalles / Asignar" />
                        <Button mnemonicParsing="false" onAction="#nuevaCompra" styleClass="add-btn" text="Nueva Compra" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
    <styleClass>
        <String fx:value="white-bg" />
    </styleClass>
</AnchorPane>
