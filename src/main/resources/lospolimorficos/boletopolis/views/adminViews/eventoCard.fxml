<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="360.0"
      prefWidth="250.0"
      spacing="0.0"
      stylesheets="@../../styles/dashboardAdmin.css"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lospolimorficos.boletopolis.viewController.viewControllersAdmin.EventoCardController">

    <styleClass>
        <String fx:value="white-bg"/>
        <String fx:value="shadow"/>
    </styleClass>

    <children>

        <!-- Imagen -->
        <ImageView fx:id="ivImagen"
                   fitHeight="150.0"
                   fitWidth="250.0"
                   pickOnBounds="true"
                   preserveRatio="false" />

        <!-- Contenido -->
        <VBox spacing="6.0">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <children>

                <!-- Nombre -->
                <Label fx:id="lblNombre"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"
                       text="Nombre del Evento"
                       wrapText="true"
                       maxWidth="230"/>

                <!-- Lugar -->
                <Label fx:id="lblLugar"
                       style="-fx-font-size: 12px; -fx-text-fill: #444444;"
                       text="Lugar Evento"
                       wrapText="true"
                       maxWidth="230"/>

                <!-- Descripción -->
                <Label fx:id="lblDescripcion"
                       style="-fx-font-size: 12px; -fx-text-fill: #555555;"
                       text="Descripción corta del evento..."
                       wrapText="true"
                       prefHeight="55"
                       maxHeight="55"
                       maxWidth="230"/>

                <!-- Fecha -->
                <Label fx:id="lblFecha"
                       style="-fx-font-size: 11px; -fx-text-fill: #666666;"
                       text="Fecha y Hora"
                       wrapText="true"/>

                <!-- Reembolsable -->
                <Label fx:id="lblReembolsable"
                       style="-fx-font-size: 11px; -fx-text-fill: #327252; -fx-font-weight: bold;"
                       text="Reembolsable"
                       visible="false"
                       managed="false"/>

                <!-- Botón -->
                <Button mnemonicParsing="false"
                        onAction="#comprarEntrada"
                        prefWidth="230.0"
                        styleClass="add-btn"
                        text="Comprar Entrada"/>

            </children>
        </VBox>

    </children>
</VBox>